# Copy this file's contents into Vercel → Project → Settings → Environment Variables.
# Do NOT commit a real .env file with real keys to GitHub.

# Required — OpenRouter powers Greta's replies. Get a key at https://openrouter.ai/keys
# Add credit to the OpenRouter account or the chat will fail once the free quota runs out.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required for checkout — PayPal Client ID (safe to be public, same idea as a Stripe publishable key).
# Sandbox app (for testing): https://developer.paypal.com/dashboard/applications  → Sandbox
# Live app (for real payments): same dashboard → Live
PAYPAL_CLIENT_ID=your-paypal-client-id

# Optional — used only in an outgoing request header sent to OpenRouter. Set to your live domain.
SITE_URL=https://your-project.vercel.app
